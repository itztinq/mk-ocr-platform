# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=mk_ocr_platform
MONGODB_JOBS_COLLECTION=jobs

# Server
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEBUG=true

# OCR
OCR_LANGUAGE=mkd
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Storage directories (leave empty for auto-detect relative to project root)
IMAGES_DIR=
OCR_OUTPUT_DIR=
TEXT_OUTPUT_DIR=
PAGE_STATUS_DIR=
